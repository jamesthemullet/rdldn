---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/index.css";
import { Image } from "astro:assets";
import Newsletter from "../components/newsletter/newsletter.astro";
import NewsletterPopup from "../components/newsletter-popup/newsletter-popup.astro";
import Search from "../components/search/search.astro";
import dreamingOfRoastDinners from "../images/dreaming of roast dinners.png";
import findARoastImg from "../images/find-a-roast.png";
import guessTheScoreImg from "../images/guess-the-score.png";
import { getHomepageData, type HomepageCard } from "../lib/homepage";

// Every section is fetched and rendered on the server in one pass, so the page never
// depends on a follow-up client-side fetch to show its content.
const {
  latestPosts,
  opengraphImage,
  favouriteRoastPages,
  locationPages,
  bestRoasts,
  features,
  roastStatistics,
} = await getHomepageData();

// Shown when a card has no featured image, or its image fails to load
const fallbackImage = dreamingOfRoastDinners.src;
const swapToFallback = `this.onerror=null;this.src=${JSON.stringify(fallbackImage)}`;

const cardSections: Array<{
  id: string;
  heading: string;
  cards: HomepageCard[];
  altPrefix: string;
  showDetails?: boolean;
}> = [
  { id: "best-roasts", heading: "A few of the best roasts:", cards: bestRoasts, altPrefix: "Photo of the roast dinner at", showDetails: true },
  { id: "features", heading: "Features:", cards: features, altPrefix: "Preview image for" },
  { id: "roastatistics", heading: "Roastatistics:", cards: roastStatistics, altPrefix: "Preview image for" },
];
---

<BaseLayout
  pageTitle="Home of Roast Dinners In London"
  description="Lord Gravy bringing you a guide to the best and worst roast dinners in London."
  opengraphImage={opengraphImage}
>
  {
    latestPosts.length > 0 && (
      <section class="home-list latest-reviews" aria-labelledby="latest-reviews-heading">
        <h2 id="latest-reviews-heading">Latest Reviews:</h2>
        <ul>
          {latestPosts.map((post, index) => (
            <li class="heading" data-post-date={post.date}>
              <h3>
                <a href={`/${post.slug}`}>
                  <Fragment set:html={post.title} />
                </a>
              </h3>
              <a href={`/${post.slug}`} class="featured-image" aria-hidden="true" tabindex="-1">
                <img
                  src={post.featuredImageUrl ?? fallbackImage}
                  onerror={swapToFallback}
                  alt={`Photo of the roast dinner at ${post.title}`}
                  width="400"
                  height="300"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    favouriteRoastPages.length > 0 && (
      <section class="home-list" aria-labelledby="find-favourite-heading">
        <h2 id="find-favourite-heading">Find Your Favourite Roast:</h2>
        <ul>
          {favouriteRoastPages.map((page) => (
            <li class="heading">
              <h3>
                <a href={`/${page.slug}`}>
                  <Fragment set:html={page.title} />
                </a>
              </h3>
              <a href={`/${page.slug}`} aria-hidden="true" tabindex="-1">
                <img
                  src={page.featuredImageUrl ?? fallbackImage}
                  onerror={swapToFallback}
                  alt={`Preview image for ${page.title}`}
                  width="400"
                  height="300"
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class="home-list interactive-features" aria-labelledby="interactive-heading">
    <h2 id="interactive-heading">Interactive:</h2>
    <ul>
      <li class="heading">
        <h3><a href="/find-a-roast">Find A Roast</a></h3>
        <a href="/find-a-roast" class="featured-image" aria-hidden="true" tabindex="-1">
          <Image src={findARoastImg} alt="Find a roast" width={400} height={300} loading="lazy" />
        </a>
      </li>
      <li class="heading">
        <h3>
          <a href="/my-roasts">My Roast List</a>
        </h3>
        <a href="/my-roasts" class="featured-image" aria-hidden="true" tabindex="-1">
          <Image src={dreamingOfRoastDinners} alt="My roast list" width={400} height={300} loading="lazy" />
        </a>
      </li>
      <li class="heading">
        <h3><a href="/guessthescore">Guess The Score</a></h3>
        <a href="/guessthescore" class="featured-image" aria-hidden="true" tabindex="-1">
          <Image src={guessTheScoreImg} alt="Guess the score" width={400} height={300} loading="lazy" />
        </a>
      </li>
      <li class="heading interactive-features__placeholder" aria-hidden="true"></li>
    </ul>
  </section>
  {
    locationPages.length > 0 && (
      <section class="home-list" aria-labelledby="roast-by-location-heading">
        <h2 id="roast-by-location-heading">Roast By Location:</h2>
        <ul>
          {locationPages.map((page) => (
            <li class="heading">
              <h3>
                <a href={`/${page.slug}`}>
                  <Fragment set:html={page.title} />
                </a>
              </h3>
              <a href={`/${page.slug}`} aria-hidden="true" tabindex="-1">
                <img
                  src={page.featuredImageUrl ?? fallbackImage}
                  onerror={swapToFallback}
                  alt={`Preview image for ${page.title}`}
                  width="400"
                  height="300"
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class="home" aria-labelledby="search-heading">
    <h2 id="search-heading">Search:</h2>
    <Search resultLimit={4} />
  </section>
  {
    cardSections
      .filter((section) => section.cards.length > 0)
      .map((section) => (
        <section class="home-list" aria-labelledby={`${section.id}-heading`}>
          <h2 id={`${section.id}-heading`}>{section.heading}</h2>
          <ul>
            {section.cards.map((card) => (
              <li class="heading">
                <h3>
                  <a href={`/${card.slug}`}>
                    <Fragment set:html={card.title} />
                  </a>
                </h3>
                <a href={`/${card.slug}`} class="featured-image" aria-hidden="true" tabindex="-1">
                  <img
                    src={card.featuredImageUrl ?? fallbackImage}
                    onerror={swapToFallback}
                    alt={`${section.altPrefix} ${card.title}`}
                    width="400"
                    height="300"
                    loading="lazy"
                  />
                </a>
                {section.showDetails && (
                  <>
                    <p>Rating: {card.rating ?? ""}</p>
                    <p>Year Visited: {card.yearVisited ?? ""}</p>
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
  }
  <Newsletter />
  <NewsletterPopup />
  <script>
    const lastVisit = localStorage.getItem("lastVisit");
    const now = new Date().toISOString();

    if (lastVisit) {
      document
        .querySelectorAll(".latest-reviews li[data-post-date]")
        .forEach((item) => {
          const postDate = item.getAttribute("data-post-date");
          if (postDate && new Date(postDate) > new Date(lastVisit)) {
            const link = item.querySelector("a.featured-image");
            if (link) {
              const badge = document.createElement("span");
              badge.className = "new-badge";
              badge.setAttribute("aria-hidden", "true");
              link.appendChild(badge);
            }
          }
        });
    }

    localStorage.setItem("lastVisit", now);
  </script>
</BaseLayout>
