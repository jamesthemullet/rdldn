---
import RoastMap from "../components/roast-map/roast-map.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import { organiseComments } from "../lib/utils";
import type { Page, Post, PostsConnection } from "../types";
import "../styles/post.css";
import Comments from "../components/comments/comments.astro";
import FeaturedPostHeader from "../components/featured-post-header/featured-post-header.astro";
import Newsletter from "../components/newsletter/newsletter.astro";
import logo3 from "../images/logo-3.png";
import { fetchGraphQL } from "../lib/api";
import GET_ALL_POST_LOCATIONS from "../lib/queries/getAllPostLocations";
import SINGLE_PAGE_QUERY_PREVIEW from "../lib/queries/singlePage";

export const prerender = true;

const variables = { id: "631" };
let singlePage: Page | null = null;
let allPosts: Post[] = [];

const firstPagePromise = fetchGraphQL<{ posts: PostsConnection }>(
  GET_ALL_POST_LOCATIONS,
  { after: null }
);
// Attach a no-op handler now so a rejection isn't reported as unhandled
// while it awaits pickup in the pagination try/catch below.
firstPagePromise.catch(() => {});

try {
  const { page } = (await fetchGraphQL(
    SINGLE_PAGE_QUERY_PREVIEW,
    variables
  )) as { page: Page | null };
  singlePage = page;
} catch (error) {
  console.error("Error fetching GraphQL data:", error);
}

try {
  let after: string | null = null;
  let hasNextPage = true;
  let isFirstFetch = true;

  while (hasNextPage) {
    const { posts }: { posts: PostsConnection } = isFirstFetch
      ? await firstPagePromise
      : await fetchGraphQL<{ posts: PostsConnection }>(
          GET_ALL_POST_LOCATIONS,
          { after }
        );
    isFirstFetch = false;

    allPosts = allPosts.concat(posts.nodes);

    hasNextPage = posts.pageInfo.hasNextPage;
    after = posts.pageInfo.endCursor;
  }
} catch (error) {
  console.error("Error fetching GraphQL data:", error);
}

if (!singlePage) {
  throw new Error("No single page data found");
}

const threadedComments = organiseComments(singlePage.comments.nodes);

const markers = allPosts
  .filter((post) => post?.location?.latitude && post?.location?.longitude)
  .map((post) => ({
    // biome-ignore lint/style/noNonNullAssertion: <we are filtering out posts without location>
    lat: Number.parseFloat(post.location!.latitude),
    // biome-ignore lint/style/noNonNullAssertion: <we are filtering out posts without location>
    lng: Number.parseFloat(post.location!.longitude),
    label: post.title,
    rating: Number(post.ratings?.nodes[0]?.name),
    slug: post.slug,
    closed: post.closedDowns?.nodes[0]?.name || "",
    year: post.yearsOfVisit?.nodes[0]?.name || "",
  }));
---

<BaseLayout
  pageTitle={singlePage.title}
  description={singlePage?.seo?.opengraphDescription}
>
  <FeaturedPostHeader
    imageSrc={singlePage?.featuredImage?.node?.sourceUrl || logo3.src}
    title={singlePage.title}
  />
  <div class="container">
    <div>
      <RoastMap client:only="react" markers={markers} />

      <Newsletter />
      <Comments
        threadedComments={threadedComments}
        postId={singlePage.pageId}
      />
    </div>
  </div>
</BaseLayout>
