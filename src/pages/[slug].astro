---
export const prerender = true;

export const response = {
  headers: {
    "Cache-Control": "public, s-maxage=86400, stale-while-revalidate=31536000"
  }
};

import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchGraphQL } from "../lib/api";
import { buildSlugCacheKey, fetchAllSlugs } from "../lib/fetchAllSlugs";
import SINGLE_PAGE_QUERY from "../lib/queries/singlePageBySlug";
import SINGLE_POST_QUERY from "../lib/queries/singlePostBySlug";
import { organiseComments } from "../lib/utils";
import "../styles/post.css";
import "../styles/post-bottom.css";
import sanitizeHtml from "sanitize-html";
import Comments from "../components/comments/comments.astro";
import FeaturedPostHeader from "../components/featured-post-header/featured-post-header.astro";
import HalloweenEasterEggs from "../components/halloween-easter-eggs/halloween-easter-eggs.astro";
import Newsletter from "../components/newsletter/newsletter.astro";
import RatingAverage from "../components/rating-average/rating-average.astro";
import RoastByTagSection from "../components/roastByTagSection/roast-by-tag-section.astro";
import ShareReviewButton from "../components/share-review-button/share-review-button.astro";
import VisitButton from "../components/visit-button/visit-button.astro";
import WishlistButton from "../components/wishlist-button/wishlist-button.astro";
import logo3 from "../images/logo-3.png";
import { buildInflationIndex } from "../lib/inflationIndex";
import { toOwnerSlug } from "../lib/ownerSlug";
import type { Page, Post } from "../types";

export async function getStaticPaths() {
  const dedicatedPageSlugs = new Set([
    "annual-roastatistics",
    "are-independent-restaurants-better-than-chains-at-roast-dinners",
  ]);

  const ALL_POST_SLUGS_QUERY = `
  query AllSlugs($first: Int!, $after: String) {
    posts(first: $first, after: $after) {
      nodes {
        slug
        modified
        commentCount
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
`;

  const ALL_PAGE_SLUGS_QUERY = `
  query AllPageSlugs($first: Int!, $after: String) {
    pages(first: $first, after: $after) {
      nodes {
        slug
        modified
        commentCount
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
`;

  const [allPosts, allPages] = await Promise.all([
    fetchAllSlugs("posts", ALL_POST_SLUGS_QUERY),
    fetchAllSlugs("pages", ALL_PAGE_SLUGS_QUERY),
  ]);

  const postPaths = allPosts
    .filter((post) => post?.slug && !dedicatedPageSlugs.has(post.slug))
    .map((post) => ({
      params: { slug: post.slug },
      props: { contentType: "post" },
      cacheKey: buildSlugCacheKey(post)
    }));

  const pagePaths = allPages
    .filter((page) => page?.slug && !dedicatedPageSlugs.has(page.slug))
    .map((page) => ({
      params: { slug: page.slug },
      props: { contentType: "page" },
      cacheKey: buildSlugCacheKey(page)
    }));

  return [...postPaths, ...pagePaths];
}

    const { slug } = Astro.params;
    const { contentType } = Astro.props;

const [{ inflationIndex, mostRecentYear }, data] = await Promise.all([
  buildInflationIndex(),
  fetchGraphQL<{ page: Page | null; post: Post | null }>(
    contentType === "page" ? SINGLE_PAGE_QUERY(slug) : SINGLE_POST_QUERY(slug)
  ),
]);

const singlePost = contentType === "page" ? data.page : data.post;

if (!singlePost) {
  return Astro.redirect("/404", 302);
}

const post = singlePost as Post;

const CLOSED_STATUS_LABELS: Record<string, string> = {
  closeddown: "Closed Down",
  newmanagement: "Under New Management",
  newowners: "Under New Owners",
  popupmoved: "Popup Now Trading Elsewhere",
  popupstopped: "Popup Stopped Trading",
  tempclosed: "Temporarily Closed",
};

const closedDownId = post.closedDowns?.nodes?.[0]?.name;

const getClosedMessage = (): string => {
  if (!closedDownId) return "";

  if (closedDownId.includes("re-reviewed")) {
    return `Re-reviewed: ${closedDownId.replace("re-reviewed-", "").trim()}`;
  }

  return CLOSED_STATUS_LABELS[closedDownId] ?? "Closed Down";
};

const currentYear = new Date().getFullYear();
const postYear = new Date(post.date).getFullYear();
const postMoreThanTwoYearsOld = postYear < currentYear - 2;
const yearOfVisit = post.yearsOfVisit?.nodes?.[0]?.name;
const price = post.prices?.nodes?.[0]?.name;
const priceMatch = price?.match(/[\d,.]+/);
const rawPrice = priceMatch ? Number.parseFloat(priceMatch[0].replace(",", "")) : null;
const inflationMultiplier = yearOfVisit ? inflationIndex?.[yearOfVisit] : undefined;
const inflationAdjustedPrice =
  rawPrice && inflationMultiplier && yearOfVisit !== mostRecentYear
    ? `~£${(rawPrice * inflationMultiplier).toFixed(2)}`
    : null;
const rating = post.ratings?.nodes?.[0]?.name;
const tubeStation = post.tubeStations?.nodes?.[0]?.name;
const tubeLines = post.tubeLines?.nodes?.map((line: { name: string }) => line.name).join(", ");
const isRoastDinner = post.typesOfPost?.nodes?.some((node: { name: string }) => node.name === "Roast Dinner");
const isHalloween = post.typesOfPost?.nodes?.some((node: { name: string }) => node.name === "Halloween") ?? false;
const isRoastReview = contentType === "post" && isRoastDinner;
const hasBookingLinks =
  post.closedDowns?.nodes?.length === 0 && Boolean(post.highlights?.website || post.highlights?.instagram);

const isRereviewed = closedDownId?.startsWith("re-reviewed");
/* istanbul ignore next */
const featuredImageUrl = (singlePost.featuredImage?.node?.sourceUrl || logo3.src) as string;

const rawContent = singlePost.content?.replace(/i\d+\.wp\.com\/rdldn\.co\.uk/g, "blog.rdldn.co.uk") ?? "";
const safeContent = sanitizeHtml(rawContent, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(["img", "figure", "figcaption", "iframe", "script"]),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    img: ["src", "srcset", "alt", "width", "height", "loading", "class"],
    iframe: ["src", "width", "height", "allowfullscreen", "frameborder", "title"],
    script: ["src", "async", "charset"],
    blockquote: ["data-bluesky-uri", "data-bluesky-cid", "data-bluesky-embed-color-mode"],
    "*": ["class", "id"],
  },
  allowedSchemes: ["http", "https", "mailto"],
  allowedScriptHostnames: ["embed.bsky.app"],
  allowVulnerableTags: true,
});

const threadedComments = organiseComments(
  (contentType === "page" ? data.page?.comments?.nodes : data.post?.comments?.nodes) ?? null
);

const reviewStructuredData =
  contentType === "post" && isRoastDinner
    ? {
        "@context": "https://schema.org",
        "@type": "Review",
        itemReviewed: {
          "@type": "Restaurant",
          name: singlePost.title,
        },
        author: {
          "@type": "Person",
          name: "Lord Gravy",
        },
        ...(rating
          ? {
              reviewRating: {
                "@type": "Rating",
                ratingValue: rating,
                bestRating: "10",
                worstRating: "0",
              },
            }
          : {}),
        datePublished: post.date,
        ...(singlePost?.seo?.opengraphDescription
          ? { description: singlePost.seo.opengraphDescription }
          : {}),
        publisher: {
          "@type": "Organization",
          name: "Roast Dinners In London",
          url: Astro.site?.toString() ?? "https://rdldn.co.uk",
        },
      }
    : undefined;
---

<BaseLayout
  pageTitle={singlePost.title ?? ""}
  description={singlePost?.seo?.opengraphDescription}
  opengraphImage={singlePost.seo?.opengraphImage?.sourceUrl}
  halloween={isHalloween}
  structuredData={reviewStructuredData}
  ogType={contentType === "post" ? "article" : "website"}
>
  <FeaturedPostHeader imageSrc={featuredImageUrl} title={singlePost.title ?? ""}>
    {(post.closedDowns?.nodes?.length ?? 0) > 0 && (
      <div slot="overlay" class="closed-overlay">
        {getClosedMessage()}
      </div>
    )}
    <p slot="meta">
      Published: {
        new Date(post.date).toLocaleDateString("en-UK", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </p>
  </FeaturedPostHeader>
  <div class="container">
    {contentType === "post" && (
      <>
        <button
          type="button"
          class="skip"
          onclick="
            const el = document.getElementById('summary');
            if (el) {
              const y = el.getBoundingClientRect().top + window.scrollY - 120;
              window.scrollTo({ top: y, behavior: 'smooth' });
              el.setAttribute('tabindex', '-1');
              el.focus({ preventScroll: true });
            }
          "
        >
          Skip The Nonsense
        </button>
        {postMoreThanTwoYearsOld && (
          <p class="warning">
            This post is from {postYear}. Maybe check some other reviews on Google Maps or something before booking.  If you have been since my visit, please let me know how it was in the comments below!
          </p>
        )}
        { (post.nSFWs?.nodes?.length ?? 0) > 0 && (
          <p class="nsfw">
            NSFW: Warning - this review may not be safe for work due to {post.nSFWs!.nodes.map((nsfw: { name: string}) => nsfw.name).join(", ")}.
          </p>
        )}
      </>
    )}
    
    <div class="post-content" set:html={safeContent} />

    {!isRoastReview && <Newsletter />}

    {isRoastReview && (
    <>
    <section id="summary" class="post-card" aria-labelledby="summary-heading">
      <h3 id="summary-heading">Summary:</h3>

      {(post.closedDowns?.nodes?.length ?? 0) > 0 && (
        <p class="closed-message">
          {getClosedMessage()}
        </p>
      )}
      <p class="post-card__title">{singlePost.title}</p>

      <dl class="post-facts">
        {rating && (
          <div class="post-fact post-fact--rating">
            <dt>Rating</dt>
            <dd class={isRereviewed ? "re-reviewed-rating" : ""}>
              <span class="rating-value">{rating}</span><span class="post-fact__scale">/10</span>
            </dd>
          </div>
        )}
        <RatingAverage postSlug={String(slug)} />
        {price && (
          <div class="post-fact">
            <dt>Price Paid{yearOfVisit && Number(yearOfVisit) !== currentYear ? ` (in ${yearOfVisit})` : ""}</dt>
            <dd>
              {price}
              {inflationAdjustedPrice && (
                <span class="inflation-price">{inflationAdjustedPrice} adjusted for inflation in {mostRecentYear}</span>
              )}
            </dd>
          </div>
        )}
        {yearOfVisit && (
          <div class="post-fact">
            <dt>Year of Visit</dt>
            <dd>{yearOfVisit}</dd>
          </div>
        )}
        {tubeStation && (
          <div class="post-fact">
            <dt>Tube Station</dt>
            <dd>{tubeStation}</dd>
          </div>
        )}
        {tubeLines && (
          <div class="post-fact">
            <dt>Tube Lines</dt>
            <dd>{tubeLines}</dd>
          </div>
        )}
        {(post.owners?.nodes?.length ?? 0) > 0 && (
          <div class="post-fact">
            <dt>Chain{(post.owners?.nodes?.length ?? 0) > 1 ? "s" : ""}</dt>
            <dd>
              {post.owners?.nodes?.map((owner: { name: string }, index: number) => (
                <>
                  <a href={`/chains/${toOwnerSlug(owner.name)}`}>{owner.name}</a>
                  {index < (post.owners?.nodes?.length ?? 0) - 1 ? ", " : ""}
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </section>

    <section class="post-card" aria-labelledby="loved-loathed-heading">
      <h3 id="loved-loathed-heading">Loved & Loathed:</h3>
      <p>Loved: {post.highlights?.loved}</p>
      <p>Loathed: {post.highlights?.loathed}</p>
    </section>

    <section class="post-card" aria-label="Visit this roast">
      {hasBookingLinks && (
        <div class="post-go">
          <h3>Go Yourself:</h3>
          <div class="post-go__links">
            {post.highlights?.website && (
              <a class="post-cta" href={post.highlights.website}>Book {singlePost.title}</a>
            )}
            {post.highlights?.instagram && (
              <a class="post-cta post-cta--secondary" href={post.highlights.instagram}>Follow on Instagram</a>
            )}
          </div>
        </div>
      )}
      <div class="post-record">
        <p>Keep your own roast record.</p>
        <div class="post-record__actions">
          <WishlistButton
            postSlug={String(slug)}
            postTitle={singlePost.title ?? ""}
            postRating={rating ?? null}
            signInText="Sign in to save, log a visit and rate it"
          />
          <VisitButton
            postSlug={String(slug)}
            postTitle={singlePost.title ?? ""}
            postRating={rating ?? null}
            hideSignIn
          />
        </div>
      </div>
    </section>

    <Newsletter variant="panel" />

    <section class="post-card post-share" aria-label="Share this review">
      <ShareReviewButton
        title={singlePost.title ?? ""}
        rating={rating}
        price={price}
        yearOfVisit={yearOfVisit}
        tubeStation={tubeStation}
        loved={post.highlights?.loved}
        loathed={post.highlights?.loathed}
        slug={String(slug)}
      />
    </section>

    <RoastByTagSection
      type="location"
      tag={post.boroughs?.nodes?.[0]?.name?.replace(/\s+/g, "-")}
    />

    <Comments threadedComments={threadedComments} postId={String(post.postId ?? "")} collapsed />
    </>
    )}

    {contentType === "page" && (
      <Comments threadedComments={threadedComments} postId={(singlePost as Page).pageId} />
    )}
  </div>

  {isHalloween && <HalloweenEasterEggs />}
</BaseLayout>

<script>
  import { addBlueskyIframeTitles } from "../lib/blueskyEmbedAccessibility";

  document.addEventListener("DOMContentLoaded", () => {
    const contentContainer = document.querySelector(".container");
    if (!contentContainer) return;

    addBlueskyIframeTitles(contentContainer);

    const observer = new MutationObserver(() => addBlueskyIframeTitles(contentContainer));
    observer.observe(contentContainer, { childList: true, subtree: true });

    // Bluesky's embed script injects the iframe asynchronously; stop watching once it's had time to load.
    setTimeout(() => observer.disconnect(), 10000);
  });
</script>
