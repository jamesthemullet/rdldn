---
type Props = {
  postSlug: string;
};

const { postSlug } = Astro.props;

import "./rating-average.css";
---

<div
  class="post-fact rating-average"
  style="display: none"
  x-data={`ratingAverage(${JSON.stringify({ postSlug })})`}
  x-show="!loading && average !== null"
>
  <dt>Public Rating</dt>
  <dd>
    <span class="rating-average__value" x-text="average === null ? '' : average.toFixed(2)"></span
    ><span class="rating-average__scale">/10</span>
    <span
      class="rating-average__count"
      x-text="`from ${ratingCount} ${ratingCount === 1 ? 'rating' : 'ratings'}`"
    ></span>
  </dd>
</div>
