{
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/London",
  "schedule": ["* 2-5 * * *"],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackageNames": ["htmlparser2"],
      "enabled": false
    },
    {
      "description": "11.0.13 statically imports rolldown into the server entry, crashing Vercel functions with FUNCTION_INVOCATION_FAILED",
      "matchPackageNames": ["@astrojs/vercel"],
      "allowedVersions": "!/^11\\.0\\.13$/"
    }
  ],
  "rebaseWhen": "conflicted"
}
